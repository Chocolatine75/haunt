{
  "name": "@haunt/mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "haunt-ci": "dist/cli.js",
    "haunt-benchmark": "dist/benchmark.js"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/vendor-playwright.mjs",
    "test": "vitest run && npm run test:perf",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:coverage": "vitest run --coverage && npm run test:perf",
    "gate": "vitest run src/gates && npm run test:perf",
    "gate:soak": "node scripts/soak.mjs 20 src/gates",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:coverage",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@mistralai/mistralai": "^2.6.4",
    "@modelcontextprotocol/sdk": "^1.10.1",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.0",
    "playwright": "^1.50.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
