  "sig-secrets": {
    "secret_field": "password",
    "load": [],
    "triggers": [
      {
        "trigger": "in-query",
        "signals": [
          {
            "signal": {
              "kind": "http_error",
              "severity": "major",
              "method": "GET",
              "path": "/sig/api/session",
              "status": 500,
              "resource_type": "fetch",
              "feedback": true
            }
          }
        ]
      },
      {
        "trigger": "in-path",
        "signals": [
          {
            "signal": {
              "kind": "http_error",
              "severity": "minor",
              "method": "GET",
              "status": 404,
              "resource_type": "fetch",
              "feedback": true
            },
            "starts_with": { "path": "/sig/api/reset/" }
          }
        ]
      },
      {
        "trigger": "in-message",
        "signals": [
          {
            "signal": {
              "kind": "js_exception",
              "severity": "major",
              "source_path": "/sig-secrets",
              "feedback": false
            },
            "contains": { "message": "is too weak" }
          }
        ]
      },
      {
        "trigger": "in-stack",
        "signals": [
          {
            "signal": {
              "kind": "js_exception",
              "severity": "major",
              "source_path": "/sig-secrets",
              "feedback": false
            },
            "contains": { "message": "Key derivation failed" }
          }
        ]
      },
      {
        "trigger": "in-console",
        "signals": [
          {
            "signal": { "kind": "console_error", "severity": "minor" },
            "contains": { "message": "login failed with password" }
          }
        ]
      },
      {
        "trigger": "in-rejection",
        "signals": [
          {
            "signal": { "kind": "unhandled_rejection", "severity": "major" },
            "contains": { "message": "was refused" }
          }
        ]
      }
    ]
  }
